{
  "name": "luckbox",
  "version": "0.1.0",
  "description": "Seeded, replayable randomness for games: dice notation with exact odds, loot tables, weighted picks, shuffle bags, card decks and daily challenges. Same seed, same results, on every device. Zero dependencies.",
  "keywords": [
    "random",
    "seeded random",
    "seedrandom",
    "prng",
    "rng",
    "deterministic",
    "game",
    "gamedev",
    "dice",
    "dice notation",
    "dnd",
    "rpg",
    "loot table",
    "weighted random",
    "shuffle bag",
    "deck",
    "daily challenge",
    "procedural generation",
    "roguelike",
    "phaser",
    "pixi",
    "threejs",
    "kaplay"
  ],
  "license": "MIT",
  "author": "Zedbury Studios",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "unpkg": "./dist/luckbox.min.js",
  "jsdelivr": "./dist/luckbox.min.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "coverage": "npm run build && vitest run --coverage",
    "size": "size-limit",
    "lint:package": "publint && attw --pack .",
    "check": "npm run typecheck && npm test && npm run size && npm run lint:package",
    "test:browser:prepare": "npm run build && node test/browser/make-expected.cjs",
    "prepublishOnly": "npm run check"
  },
  "size-limit": [
    {
      "name": "everything (ESM, minified + brotli)",
      "path": "dist/index.js",
      "limit": "10 KB"
    },
    {
      "name": "script tag build (minified + brotli)",
      "path": "dist/luckbox.min.js",
      "limit": "10 KB"
    }
  ]
}

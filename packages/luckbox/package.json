{
  "name": "luckbox",
  "version": "0.4.0",
  "description": "Seeded, replayable randomness for games: dice notation with exact odds, loot tables with gacha pity and real drop rates, weighted picks, shuffle bags, decks, bell curves, Poisson-disk scatter, simplex noise and daily challenges. Same seed, same results, on every device. Zero dependencies.",
  "keywords": [
    "random",
    "seeded random",
    "seedrandom",
    "prng",
    "rng",
    "deterministic",
    "game",
    "gamedev",
    "dice",
    "dice notation",
    "dnd",
    "rpg",
    "loot table",
    "weighted random",
    "shuffle bag",
    "deck",
    "daily challenge",
    "procedural generation",
    "roguelike",
    "phaser",
    "pixi",
    "threejs",
    "kaplay",
    "noise",
    "simplex noise",
    "gacha",
    "pity",
    "poisson disk",
    "normal distribution"
  ],
  "license": "MIT",
  "author": "Zedbury Studios",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "unpkg": "./dist/luckbox.min.js",
  "jsdelivr": "./dist/luckbox.min.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./noise": {
      "import": {
        "types": "./dist/noise.d.ts",
        "default": "./dist/noise.js"
      },
      "require": {
        "types": "./dist/noise.d.cts",
        "default": "./dist/noise.cjs"
      }
    },
    "./seedrandom": {
      "import": {
        "types": "./dist/seedrandom.d.ts",
        "default": "./dist/seedrandom.js"
      },
      "require": {
        "types": "./dist/seedrandom.d.cts",
        "default": "./dist/seedrandom.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "noise/package.json",
    "seedrandom/package.json",
    "examples",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.cli.json && tsc -p test/tsconfig.json",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "coverage": "npm run build && vitest run --coverage",
    "size": "size-limit",
    "lint:package": "publint && attw --pack .",
    "check": "npm run typecheck && npm test && npm run size && npm run lint:package",
    "test:browser:prepare": "npm run build && node test/browser/make-expected.cjs",
    "prepublishOnly": "npm run check",
    "test:cross": "npm run build && node test/cross/all.mjs",
    "bench": "npm run build && node bench/bench.mjs"
  },
  "size-limit": [
    {
      "name": "luckbox (minified + brotli)",
      "path": "dist/index.js",
      "limit": "15 KB"
    },
    {
      "name": "luckbox/noise",
      "path": "dist/noise.js",
      "limit": "3 KB"
    },
    {
      "name": "luckbox/seedrandom",
      "path": "dist/seedrandom.js",
      "limit": "2 KB"
    },
    {
      "name": "script tag build, everything",
      "path": "dist/luckbox.min.js",
      "limit": "17 KB"
    }
  ],
  "bin": {
    "luckbox": "./dist/cli.mjs"
  }
}
